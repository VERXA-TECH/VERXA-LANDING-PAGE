# Supabase (server-only — never expose SERVICE_ROLE_KEY to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL for Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (public). For localhost before it's an allowed hostname,
# use Cloudflare's invisible always-pass test key: 1x00000000000000000000BB
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFiInjqGHc4Cb5NU

# Verxa backend (server-only). Leave empty to skip the backend and only save to Supabase.
VERXA_API_BASE_URL=
